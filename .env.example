OLLAMA_MODEL=kino-optimized
OLLAMA_HOST=http://localhost:11434

# Server-only URL and shared Bearer secret for the persistent browser worker.
KINO_BROWSER_WORKER_URL=http://127.0.0.1:8787
KINO_BROWSER_WORKER_TOKEN=replace-with-a-long-random-secret

# Controller safeguards.
KINO_BROWSER_MAX_STEPS=20
KINO_BROWSER_MAX_RUNTIME_MS=180000

# Standalone worker settings.
KINO_BROWSER_WORKER_HOST=127.0.0.1
KINO_BROWSER_WORKER_PORT=8787
KINO_BROWSER_SESSION_TTL_MS=1800000
KINO_BROWSER_MAX_SESSIONS=20
KINO_BROWSER_HEADLESS=true

# Development only. Ignored as an escape hatch in production.
KINO_BROWSER_ALLOW_PRIVATE_NETWORKS=false
