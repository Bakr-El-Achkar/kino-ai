{
  "name": "kino-ai",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "browser-worker": "node --experimental-strip-types browser-worker/server.ts",
    "test": "npm run test:action-engine && npm run test:form-drafts && npm run test:form-fills && npm run test:sensitive-form-fills && npm run test:browser-agent && npm run test:thinking-mode && npm run test:chat-stream && npm run test:activity",
    "test:activity": "node --experimental-strip-types scripts/activity-unit-test.mjs",
    "test:chat-stream": "node --experimental-strip-types scripts/chat-stream-unit-test.mjs",
    "test:action-engine": "node --experimental-strip-types scripts/action-engine-unit-test.mjs",
    "test:form-drafts": "node --experimental-strip-types scripts/form-draft-unit-test.mjs",
    "test:form-fills": "node --experimental-strip-types scripts/form-fill-unit-test.mjs",
    "test:sensitive-form-fills": "node --experimental-strip-types scripts/sensitive-form-fill-unit-test.mjs",
    "test:thinking-mode": "node --experimental-strip-types scripts/thinking-mode-unit-test.mjs",
    "test:browser-agent": "node --experimental-strip-types scripts/browser-agent-unit-test.mjs",
    "web-agent": "node scripts/web-agent-test.mjs",
    "web-agent:connect": "node scripts/web-agent-connect.mjs",
    "web-agent:session-test": "node scripts/web-agent-session-test.mjs",
    "web-agent:inspect": "node scripts/web-agent-inspect.mjs",
    "web-agent:navigate": "node scripts/web-agent-navigate.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
